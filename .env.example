# Copy this to `.env` next to docker-compose.yml on the server (docker compose
# auto-loads a file literally named `.env` from the compose file's directory).
#
# This covers only the secrets that were already being injected as env vars in
# production (Mongo/S3/SMS/Zarinpal/Telegram credentials + connection info).
# Everything else (auth.sign_key, zarinpal URLs, media policies, mellipayamak
# url/patterns, payment/scheduler settings, ...) lives in config.yml, which is
# mounted read-only into the app container by docker-compose.yml.

ST_MONGO__USERNAME=changeme
ST_MONGO__PASSWORD=changeme
ST_MONGO__DB_NAME=steve

ST_OBJECT_STORAGE__AWS_ACCESS_KEY_ID=changeme
ST_OBJECT_STORAGE__AWS_SECRET_ACCESS_KEY=changeme
ST_OBJECT_STORAGE__ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ST_OBJECT_STORAGE__PUBLIC_BUCKET_NAME=changeme

ST_MELLIPAYAMAK__USERNAME=changeme
ST_MELLIPAYAMAK__PASSWORD=changeme

ST_ZARINPAL__MERCHANT_ID=changeme

ST_TELEGRAM_BOT__ADMIN_API_TOKEN_BOT=changeme
ST_TELEGRAM_BOT__DEVELOPER_API_TOKEN_BOT=changeme
ST_TELEGRAM_BOT__ADMIN_CHAT_ID=changeme
ST_TELEGRAM_BOT__DEVELOPER_CHAT_ID=changeme
