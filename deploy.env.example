# Copy this to `deploy.env` (same directory, gitignored) and fill in real
# values. deploy.sh sources it automatically if present. Never put real
# credentials in deploy.env.example or in deploy.sh itself - both are tracked
# in git.
#
# Password auth (sshpass) is supported to match how this team already
# deploys the storefront/backoffice services, but an SSH key is preferred
# when available: just leave SERVER_PASS unset and deploy.sh will use a
# plain `ssh` (key/agent) connection instead.

SERVER_USER=root
SERVER_IP=changeme
SERVER_PASS=changeme
SERVER_PORT=22
