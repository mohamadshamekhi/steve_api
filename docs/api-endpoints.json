{
  "_meta": {
    "description": "فهرست همه‌ی اندپوینت‌های HTTP سرور Steve. هر تغییری در روت‌ها (افزودن/حذف/به‌روزرسانی) باید همین فایل هم به‌روز شود.",
    "auth_kinds": {
      "public": "بدون احراز هویت",
      "user": "JWT کاربر فروشگاه (middleware.Auth)",
      "backoffice": "JWT کاربر پنل ادمین (BackofficeAuth)",
      "backoffice+ACL:<key>": "کاربر پنل ادمین + بررسی مجوز نقش با کلید key.<key>"
    },
    "base_path_note": "همه‌ی پاسخ‌ها در قالب APIResponse ({message, data}) برگردانده می‌شوند.",
    "last_updated": "2026-09-07"
  },

  "auth": [
    { "method": "POST", "path": "/user/send-otp", "auth": "public", "in": "{phone_number}", "out": "{message}", "desc": "ارسال کد OTP ورود کاربر فروشگاه" },
    { "method": "POST", "path": "/user/verify-otp", "auth": "public", "in": "{phone_number, code}", "out": "{access_token, refresh_token, user}", "desc": "تأیید OTP و صدور توکن کاربر" },
    { "method": "POST", "path": "/user/logout", "auth": "user", "in": "-", "out": "{message}", "desc": "خروج و بلاک‌لیست کردن توکن" },
    { "method": "POST", "path": "/user/me", "auth": "user", "in": "-", "out": "{user}", "desc": "اطلاعات کاربر جاری" },
    { "method": "POST", "path": "/back-office/send-otp", "auth": "public", "in": "{phone_number}", "out": "{message}", "desc": "ارسال OTP ورود کاربر پنل ادمین" },
    { "method": "POST", "path": "/back-office/verify-otp", "auth": "public", "in": "{phone_number, code}", "out": "{access_token, refresh_token}", "desc": "تأیید OTP و صدور توکن ادمین" }
  ],

  "user": [
    { "method": "PATCH", "path": "/user/:id/update-profile", "auth": "user", "in": "{first_name, last_name, ...}", "out": "{message}", "desc": "ویرایش پروفایل کاربر" },
